<?xml version="1.0" encoding="UTF-8"?><XMI xmlns:UML="href://org.omg/UML/1.3" xmi.version="1.1">
    <XMI.header>
        <XMI.documentation>
            <XMI.exporter>PlantUML</XMI.exporter>
            <XMI.exporterVersion>1.2024.8</XMI.exporterVersion>
        </XMI.documentation>
        <XMI.metamodel xmi.name="UML" xmi.version="1.4"/>
    </XMI.header>
    <XMI.content>
        <UML:Model name="PlantUML" xmi.id="model1">
            <UML:Namespace.ownedElement>
                <UML:Class name="EstadoConsulta" xmi.id="cl0003">
                    <UML:Classifier.feature>
                        <UML:Attribute name="REGISTRADA" xmi.id="att29"/>
                        <UML:Attribute name="ATENDIDA" xmi.id="att30"/>
                        <UML:Attribute name="DERIVADA" xmi.id="att31"/>
                        <UML:Attribute name="CERRADA" xmi.id="att32"/>
                        <UML:Attribute name="DESCARTADA" xmi.id="att33"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="OrigenConsulta" xmi.id="cl0004">
                    <UML:Classifier.feature>
                        <UML:Attribute name="FICHA" xmi.id="att34"/>
                        <UML:Attribute name="COMPARADOR" xmi.id="att35"/>
                        <UML:Attribute name="VISTA_RAPIDA" xmi.id="att36"/>
                        <UML:Attribute name="DONDE_COMPRAR" xmi.id="att37"/>
                        <UML:Attribute name="SOPORTE" xmi.id="att38"/>
                        <UML:Attribute name="GENERAL" xmi.id="att39"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="Intencion" xmi.id="cl0005">
                    <UML:Classifier.feature>
                        <UML:Attribute name="COTIZAR" xmi.id="att40"/>
                        <UML:Attribute name="DONDE_COMPRAR" xmi.id="att41"/>
                        <UML:Attribute name="SOPORTE" xmi.id="att42"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="EstadoDistribuidor" xmi.id="cl0006">
                    <UML:Classifier.feature>
                        <UML:Attribute name="SOLICITADO" xmi.id="att43"/>
                        <UML:Attribute name="ACTIVO" xmi.id="att44"/>
                        <UML:Attribute name="SUSPENDIDO" xmi.id="att45"/>
                        <UML:Attribute name="RECHAZADO" xmi.id="att46"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="ConsultaComercial" xmi.id="cl0007">
                    <UML:ModelElement.stereotype>
                        <UML:Stereotype name="propuesto"/>
                    </UML:ModelElement.stereotype>
                    <UML:Classifier.feature>
                        <UML:Attribute name="id : long" visibility="private" xmi.id="att47"/>
                        <UML:Attribute name="fechaHora : DateTime" visibility="private" xmi.id="att48"/>
                        <UML:Attribute name="origen : OrigenConsulta" visibility="private" xmi.id="att49"/>
                        <UML:Attribute name="intencion : Intencion" visibility="private" xmi.id="att50"/>
                        <UML:Attribute name="urlOrigen : String" visibility="private" xmi.id="att51"/>
                        <UML:Attribute name="mensaje : String" visibility="private" xmi.id="att52"/>
                        <UML:Attribute name="estado : EstadoConsulta" visibility="private" xmi.id="att53"/>
                        <UML:Attribute name="observacion : String [0..1]" visibility="private" xmi.id="att54"/>
                        <UML:Operation name="atender(u : Usuario) : void" visibility="public" xmi.id="att55"/>
                        <UML:Operation name="derivar(d : Distribuidor) : void" visibility="public" xmi.id="att56"/>
                        <UML:Operation name="cerrar() : void" visibility="public" xmi.id="att57"/>
                        <UML:Operation name="descartar(motivo : String) : void" visibility="public" xmi.id="att58"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="Distribuidor" xmi.id="cl0008">
                    <UML:ModelElement.stereotype>
                        <UML:Stereotype name="propuesto"/>
                    </UML:ModelElement.stereotype>
                    <UML:Classifier.feature>
                        <UML:Attribute name="id : int" visibility="private" xmi.id="att59"/>
                        <UML:Attribute name="razonSocial : String" visibility="private" xmi.id="att60"/>
                        <UML:Attribute name="ruc : String" visibility="private" xmi.id="att61"/>
                        <UML:Attribute name="region : String" visibility="private" xmi.id="att62"/>
                        <UML:Attribute name="ciudad : String" visibility="private" xmi.id="att63"/>
                        <UML:Attribute name="whatsapp : String" visibility="private" xmi.id="att64"/>
                        <UML:Attribute name="numTiendas : int [0..1]" visibility="private" xmi.id="att65"/>
                        <UML:Attribute name="estado : EstadoDistribuidor" visibility="private" xmi.id="att66"/>
                        <UML:Attribute name="consentimiento : boolean" visibility="private" xmi.id="att67"/>
                        <UML:Operation name="aprobar() : void" visibility="public" xmi.id="att68"/>
                        <UML:Operation name="suspender() : void" visibility="public" xmi.id="att69"/>
                        <UML:Operation name="esVisible() : boolean" visibility="public" xmi.id="att70"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="ServicioConsulta" xmi.id="cl0009">
                    <UML:ModelElement.stereotype>
                        <UML:Stereotype name="propuesto"/>
                    </UML:ModelElement.stereotype>
                    <UML:Classifier.feature>
                        <UML:Operation name="construirMensaje(i : Intencion, p : Producto [0..1]) : String" visibility="public" xmi.id="att71"/>
                        <UML:Operation name="generarEnlaceWhatsApp(numero : String, mensaje : String) : String" visibility="public" xmi.id="att72"/>
                        <UML:Operation name="registrar(c : ConsultaComercial) : void" visibility="public" xmi.id="att73"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="Producto" xmi.id="cl0010">
                    <UML:Classifier.feature>
                        <UML:Attribute name="modelo : String" visibility="private" xmi.id="att74"/>
                        <UML:Operation name="obtenerUrlFicha() : String" visibility="public" xmi.id="att75"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Class name="Usuario" xmi.id="cl0012">
                    <UML:Classifier.feature>
                        <UML:Attribute name="id : int" visibility="private" xmi.id="att76"/>
