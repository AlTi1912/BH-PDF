                    <UML:Classifier.feature>
                        <UML:Operation name="registrar(u : Usuario, accion : String, entidad : String, id : long) : void" visibility="public" xmi.id="att93"/>
                    </UML:Classifier.feature>
                </UML:Class>
                <UML:Association name="sobre" namespace="model1" xmi.id="ass94">
                    <UML:Association.connection>
