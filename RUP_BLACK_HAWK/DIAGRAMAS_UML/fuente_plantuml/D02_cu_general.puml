@startuml D02_cu_general
!include _estilo.iuml
left to right direction
skinparam packageStyle rectangle
title D-02 · Diagrama general de casos de uso del sistema SGCD-BH

actor "Visitante" as VI
actor "Cliente\ninteresado" as CI
actor "Distribuidor" as DI
actor "Servicio externo\nde WhatsApp" <<sistema>> as WA

rectangle "SGCD-BH" {
  package "Catálogo público y comercial" as P1 {
    usecase "CU-01 Explorar catálogo\npor categoría" as CU01
    usecase "CU-03 Filtrar productos" as CU03
    usecase "CU-02 Buscar producto" as CU02
    usecase "CU-04 Consultar ficha técnica" as CU04
    usecase "CU-05 Comparar productos" as CU05
    usecase "CU-06 Consultar novedades" as CU06
    usecase "CU-07 Consultar dónde\ncomprar" as CU07
    usecase "CU-08 Enviar consulta\npor WhatsApp" as CU08
    usecase "CU-09 Registrar consulta\ncomercial" <<propuesto>> as CU09
    usecase "CU-10 Solicitar incorporación\ncomo distribuidor" as CU10
  }
  package "Administración" as P2 {
    usecase "CU-11 Autenticarse" as CU11
    usecase "CU-12 Gestionar productos" as CU12
    usecase "CU-13 Gestionar categorías" as CU13
    usecase "CU-14 Gestionar especificaciones\ntécnicas" as CU14
    usecase "CU-15 Gestionar imágenes" as CU15
    usecase "CU-16 Gestionar distribuidores" <<propuesto>> as CU16
    usecase "CU-17 Gestionar contenido\ny novedades" as CU17
    usecase "CU-18 Dar seguimiento\na consultas" <<propuesto>> as CU18
    usecase "CU-19 Gestionar usuarios\ny roles" as CU19
    usecase "CU-20 Generar reportes" <<propuesto>> as CU20
    usecase "CU-21 Consultar auditoría" <<propuesto>> as CU21
    usecase "CU-22 Gestionar respaldos\ny mantenimiento" as CU22
  }
}

actor "Gestor del\ncatálogo" as GC
actor "Administrador\ndel sistema" as AD

CI -|> VI
VI -- CU01
VI -- CU02
VI -- CU04
VI -- CU05
VI -- CU06
CU03 .> CU01 : <<extend>>
CI -- CU07
CI -- CU08
CU08 ..> CU09 : <<include>>
DI -- CU10
WA -- CU08

CU09 -[hidden]- CU11
CU10 -[hidden]- CU17
CU06 -[hidden]- CU14

CU11 -- GC
CU12 -- GC
CU13 -- GC
CU14 -- GC
CU15 -- GC
CU16 -- GC
CU17 -- GC
CU18 -- GC
CU19 -- AD
CU20 -- AD
CU21 -- AD
CU22 -- AD
AD -|> GC

legend right
  <back:#EDE4FB>      </back>  Propuesto (alcance académico)
  <back:#FFFFFF>      </back>  Existente o nativo de la plataforma
endlegend
@enduml
