@startuml D06_cu_admin_sistema
!include _estilo.iuml
left to right direction
title D-06 · Casos de uso — Usuarios, reportes, auditoría y mantenimiento

actor "Administrador\ndel sistema" as AD

rectangle "SGCD-BH · Administración del sistema" {
  usecase "CU-19 Gestionar usuarios\ny roles" as CU19
  usecase "CU-20 Generar reportes\nadministrativos" <<propuesto>> as CU20
  usecase "CU-21 Consultar auditoría" <<propuesto>> as CU21
  usecase "CU-22 Gestionar respaldos\ny mantenimiento" as CU22
}
AD -- CU19
AD -- CU20
AD -- CU21
AD -- CU22
note right of CU20
  Consultas por producto, categoría,
  origen y periodo; productos más
  comparados; exportación CSV.
  Miden intención, no ventas.
end note
note right of CU22
  Capacidad del hosting por validar:
  se especifica el procedimiento
  (RPO ≤ 24 h, RTO ≤ 4 h).
end note
@enduml
