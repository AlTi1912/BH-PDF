@startuml V3_01_casos_de_uso
!include _estilo.iuml
left to right direction
skinparam defaultFontSize 14
skinparam packageStyle rectangle
title V3-01 · Casos de uso de la web renovada de Black Hawk (adaptado de D-02)

actor "Visitante" as VI
actor "Cliente\ninteresado" as CI
actor "Distribuidor /\ntienda" as DI
CI -|> VI

rectangle "Web renovada Black Hawk (SGCD-BH)" {
 package "Sitio público" {
  usecase "CU-01 Explorar catálogo\npor categoría" as CU01
  usecase "CU-03 Filtrar productos" as CU03
  usecase "CU-02 Buscar producto" as CU02
  usecase "CU-04 Consultar ficha técnica" as CU04
  usecase "CU-05 Comparar productos\n(hasta 3)" as CU05
  usecase "CU-08 Cotizar por WhatsApp\n(mensaje con el modelo)" as CU08
  usecase "CU-09 Registrar inicio\nde consulta" <<propuesto>> as CU09
  usecase "CU-07 Consultar\ndónde comprar" as CU07
  usecase "CU-10 Solicitar ser\ndistribuidor" as CU10
 }
 package "Administración" {
  usecase "CU-12 Gestionar productos\ny categorías" as CU12
  usecase "CU-17 Gestionar contenidos" as CU17
  usecase "CU-16 Gestionar directorio\nde distribuidores" <<propuesto>> as CU16
  usecase "CU-20 Ver reportes\nde consultas" <<propuesto>> as CU20
 }
}
actor "Gestor del\ncatálogo" as GC
actor "WhatsApp\n«sistema externo»" as WA

VI -- CU01
VI -- CU02
VI -- CU04
VI -- CU05
CU03 .> CU01 : <<extend>>
CI -- CU08
CI -- CU07
DI -- CU10
CU08 ..> CU09 : <<include>>\n(propuesto)
CU08 -- WA
CU09 -[hidden]- CU12
CU07 -[hidden]- CU17
CU10 -[hidden]- CU16
CU12 -- GC
CU17 -- GC
CU16 -- GC
CU20 -- GC
legend right
  <back:#FFFFFF>      </back>  Desarrollado en el rediseño
  <back:#EDE4FB>      </back>  Ampliación propuesta
endlegend
@enduml
